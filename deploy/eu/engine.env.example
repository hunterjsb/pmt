# Skeleton for /home/ec2-user/.pmt/engine.env on the EU box (0600, ec2-user).
#
# NO KEY MATERIAL HERE. The L0 EOA private key lives in ~/.pmt/l0.env and
# nowhere else; the unit sources both files.
#
# No proxy vars either — the EU box reaches clob.polymarket.com directly.
# That is the entire reason the box exists, so pointing it at pmproxy would
# undo the geography and route orders back through a US egress.

PM_SIGNATURE_TYPE=3
PM_FUNDER_ADDRESS=0x6da3e7Dd76cE67B32ae7911e19da0c00550F1D71

# Pilot series. SPLIT-BRAIN HAZARD: a series armed here MUST be dropped from
# the desktop's allowlist first — two wallets quoting the same market at the
# same time is the failure this partition exists to prevent.
PMENGINE_SERIES_ALLOWLIST=bnb-updown-5m

# Deliberately tiny — this is a trust-ladder proof, not a size run.
PMENGINE_MAX_POSITION_SIZE=30
PMENGINE_MAX_TOTAL_EXPOSURE=60
PMENGINE_MAX_LOSS=15
