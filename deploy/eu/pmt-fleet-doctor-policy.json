{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnHeartbeatOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-1:350985642081:table/pmt-fleet",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "node#euw"
          ]
        }
      }
    },
    {
      "Sid": "SeriesLeases",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-1:350985642081:table/pmt-fleet",
      "Condition": {
        "ForAllValues:StringLike": {
          "dynamodb:LeadingKeys": [
            "series#*"
          ]
        }
      }
    },
    {
      "Sid": "ReadKillSwitchNeverWriteIt",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-1:350985642081:table/pmt-fleet",
      "Condition": {
        "ForAllValues:StringEquals": {
          "dynamodb:LeadingKeys": [
            "fleet"
          ]
        }
      }
    }
  ]
}
