# pmt spot recorder — live exchange tick capture, as a systemd USER service.
#
# PROPOSAL, not installed. See README.md in this directory.
#
# The THIRD recorder, and a sibling of pmt-rtds-recorder for the same reason
# the print recorder is one: separate processes cannot stall each other. This
# one holds three websocket connections (Binance, Kraken, Hyperliquid) and its
# whole job is to not miss a frame on any of them.
#
# What it records and why it cannot be backfilled: opponent_model.md §1d
# measures the makers leading our settlement feed by ~3s, of which ~1.3s is
# genuine information — they price the underlying spot market that Chainlink
# then follows. Reading that same underlying is the only thing that closes it.
# `klines-1m-*.jsonl` cannot stand in: a 1-minute bar has no opinion about a
# 3-second lead. Neither Binance nor Kraken serves a historical TICK feed for
# free, so an hour nobody recorded is an hour the lead estimate can never be
# measured on. Same argument as the RTDS unit, and restart-on-failure is
# equally uncontroversial: it writes tapes, it never places an order.
#
# ---------------------------------------------------------------------------
# READ THIS BEFORE INSTALLING: this unit writes ~5 GB/day at defaults.
# ---------------------------------------------------------------------------
# Measured on the 2026-08-24 run, six symbols, one weekday European afternoon:
#
#     binance      ~370 rows/s   (btc alone ~150/s)   ~215 MB/h
#     kraken       ~5 rows/s                          ~0.4 MB/h
#     hyperliquid  ~0.2 rows/s                        ~0.02 MB/h
#
# Binance's raw trade tape is three orders of magnitude the volume of anything
# else in ~/.pmt/corpus, and it is NOT swept by `scripts/pmt-backup.sh` sizing
# assumptions. Before this becomes resident, pick one:
#
#   * narrow it   — `--symbols btc,eth` is ~65% of the rows for the two symbols
#                   the fleet actually trades most;
#   * bound it    — add a retention sweep like the print recorder's
#                   `--retention-days`, which this recorder does NOT yet have;
#   * or keep it bounded — `--minutes N` under a .timer, which is how the
#                   study ran it and is the honest default until someone has
#                   decided what the steady-state corpus is for.
#
# The ExecStart below is deliberately the NARROW form rather than the full
# universe, so an install that skips this comment still fits on the disk.
# Widen it on purpose, not by default.

[Unit]
Description=pmt spot recorder — live exchange tick capture (Binance/Kraken/Hyperliquid)
Documentation=file:///var/home/hunter/Desktop/code/pmt/deploy/systemd/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/var/home/hunter/Desktop/code/pmt/pmtrader
# `uv run` resolves the pmtrader venv from the cwd's pyproject.toml, so the
# WorkingDirectory above is load-bearing, not cosmetic.
#
# --symbols is narrowed on purpose; see the disk note in the header.
ExecStart=/var/home/hunter/.local/bin/uv run python -m polymarket.spot --symbols btc,eth,sol,xrp,bnb,doge,hype --venues kraken,hyperliquid

Restart=on-failure
RestartSec=10
RestartSteps=5
RestartMaxDelaySec=300

KillSignal=SIGTERM
TimeoutStopSec=20

SyslogIdentifier=pmt-spot

[Install]
WantedBy=default.target
