# pmt print recorder — Polymarket public print (trade) tape capture, as a
# systemd USER service.
#
# PROPOSAL, not installed. See README.md in this directory.
#
# The SIBLING of pmt-rtds-recorder. Both write market data nobody can go back
# and re-observe as it looked live, and neither ever places an order, so
# restart-on-failure is uncontroversial for both.
#
# Why a second unit instead of folding this into the RTDS recorder's process:
# that recorder is a websocket consumer whose whole job is to not miss a frame,
# and this one makes blocking REST calls to a host (data-api) that has been
# measured stalling for whole seconds under contention. Putting a multi-second
# HTTP call inside the stream reader's loop is the exact shape of the bug
# analysis/watch_load.md is about. Separate processes cannot do that to each
# other.
#
# Unlike the stream, prints ARE backfillable — data-api serves full history per
# market long after a window resolves — so a gap here is recoverable with
# `--once`, and this unit is the less urgent of the two.

[Unit]
Description=pmt print recorder — Polymarket public print tape capture
Documentation=file:///var/home/hunter/Desktop/code/pmt/deploy/systemd/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/var/home/hunter/Desktop/code/pmt/pmtrader
# `uv run` resolves the pmtrader venv from the cwd's pyproject.toml, so the
# WorkingDirectory above is load-bearing, not cosmetic.
ExecStart=/var/home/hunter/.local/bin/uv run python -m polymarket.prints

Restart=on-failure
RestartSec=10
RestartSteps=5
RestartMaxDelaySec=300

KillSignal=SIGTERM
TimeoutStopSec=30

SyslogIdentifier=pmt-prints

[Install]
WantedBy=default.target
