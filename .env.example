# pmt — Polymarket trading toolkit
# Copy this file to `.env` and fill in your credentials. `.env` is gitignored.

# ==================================================
# TRADING CREDENTIALS
# ==================================================

# Polygon EOA private key that signs orders. Never commit.
PM_PRIVATE_KEY=0x...

# Wallet address that holds funds / positions.
# For Polymarket Proxy (signature_type=1), this is the proxy address, NOT
# the EOA address — the EOA owns the proxy and signs on its behalf.
PM_FUNDER_ADDRESS=0x...

# 0 = EOA, 1 = Polymarket Proxy, 2 = EIP-1271 / GnosisSafe
PM_SIGNATURE_TYPE=1

# ==================================================
# pmproxy — required to trade from a geoblocked region
# ==================================================

# Function URL of the deployed Lambda (or your own pmproxy host).
PMPROXY_URL=https://<...>.lambda-url.eu-west-1.on.aws

# Auth is SigV4: the Function URL is AWS_IAM, so requests are signed with
# your local AWS credentials (`aws configure` / SSO / instance role) — there
# is nothing to put here. Override the signing region only if the proxy
# isn't in eu-west-1.
# PMPROXY_AWS_REGION=eu-west-1

# ==================================================
# pmengine — Rust trading engine
# ==================================================

# Risk limits (USDC). Cap engine exposure per market and across all markets.
PMENGINE_MAX_POSITION_SIZE=1500
PMENGINE_MAX_TOTAL_EXPOSURE=1500

# REST orderbook poll interval (ms) while the market WebSocket is DOWN. The WS
# is the authoritative book source; this is the fallback cadence, and it is
# what the engine ran at for every book before the WS carried them.
PMENGINE_BOOK_POLL_MS=2000

# REST orderbook poll interval (ms) while the WS is UP. The poll is then only a
# health check and a full-depth resync — the hub drops any snapshot older than
# the WS state it already holds.
PMENGINE_BOOK_POLL_SLOW_MS=10000

# Cadence (seconds) of the "Book health" INFO line: WS state, event rate, and
# the book-age p50/p90/max across every subscribed token.
PMENGINE_BOOK_HEALTH_S=60

# At startup, cancel pre-existing user orders on the strategies' subscribed
# tokens. Treat the engine as the sole order manager for those markets.
# Set to false if a human is placing manual maker orders alongside.
PMENGINE_RECONCILE_ON_STARTUP=true
